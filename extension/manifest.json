{
  "manifest_version": 3,
  "name": "YT AutoDownload Queue",
  "version": "1.0.0",
  "description": "Queue YouTube videos, playlists and public channels for local yt-dlp downloading.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT AutoDownload Queue"
  }
}
